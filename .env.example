# Скопируйте в .env для локального запуска; на Bothost задаётся в панели «Переменные окружения»
BOT_TOKEN=123456:ABC-your-token
ADMIN_ID=123456789

# Необязательные (значения по умолчанию показаны)
FLASK_PORT=8080
LOCK_PORT=48975
DISABLE_INSTANCE_LOCK=0

# База данных: без значения используется sqlite:///workshop.db
# Для PostgreSQL на Bothost: postgresql://user:pass@host:5432/dbname
# DATABASE_URL=sqlite:///workshop.db

# GigaChat (опционально, для ИИ-ответов)
# GIGACHAT_CREDENTIALS=
